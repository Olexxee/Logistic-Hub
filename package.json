{
  "name": "logistic-hub-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Logistic Hub",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "test": "node --test",
    "api:validate": "node scripts/validate-openapi.js && node scripts/validate-route-contract.js",
    "db:validate-foundation-constraints": "node scripts/validate-foundation-constraints.js",
    "postinstall": "npm run db:generate",
    "db:seed:nigeria": "node scripts/seed-nigeria-geography.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "pino-http": "10.5.0",
    "zod": "3.25.76",
    "cloudinary": "2.11.0"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "@apidevtools/swagger-parser": "10.1.0"
  }
}
