NODE_ENV=development
# APP_STAGE controls the KYC safety boundary: local, staging, or production.
APP_STAGE=local
# TEST permits TEST_LIMITED parcel-delivery testing without full KYC; production must use STRICT.
DRIVER_KYC_MODE=TEST
# Maximum age accepted for a driver's last reported location during dispatch eligibility.
DRIVER_LOCATION_MAX_AGE_SECONDS=300
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
CORS_ORIGINS=http://localhost:5173
MAPS_PROVIDER=none
GOOGLE_MAPS_API_KEY=
# Server-side key only. Enable Places API (New), Geocoding API and Routes API; restrict the key to these APIs.
EMAIL_PROVIDER=none
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Generate with: openssl rand -base64 32 (use the exact same value for API and worker)
OUTBOX_ENCRYPTION_KEY=
# Optional: encrypts stored partner webhook secrets; use a separate base64 32-byte key.
WEBHOOK_SECRET_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
PAYMENTS_ENABLED=false
# Provider refund submission is separately gated; keep disabled until explicitly approved.
REFUNDS_ENABLED=false
PAYSTACK_SECRET_KEY=
# Private support evidence storage. Keep Cloudinary credentials server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Legacy Firebase credentials are only needed to read evidence uploaded before migration.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_STORAGE_BUCKET=
# Production CORS_ORIGINS must contain the exact deployed frontend origin (no wildcard).
# Browser refresh sessions use an HttpOnly cookie; prefer the frontend same-origin API proxy.
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/return

# One-time local staging Admin bootstrap only. Never set these on a deployed service.
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_FULL_NAME=
STAGING_ADMIN_PASSWORD=
