NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
CORS_ORIGINS=http://localhost:5173
MAPS_PROVIDER=none
GOOGLE_MAPS_API_KEY=
EMAIL_PROVIDER=none
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_BASE_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=
# Production CORS_ORIGINS must contain the exact deployed frontend origin (no wildcard).
# Browser refresh sessions use an HttpOnly cookie; prefer the frontend same-origin API proxy.
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/return
