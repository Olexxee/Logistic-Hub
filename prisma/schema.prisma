}




model PartnerPayable {
  id                          String               @id @default(cuid())
  partnerId                   String
  partnerDeliveryAssignmentId String               @unique
  agreementId                 String
  deliveryLegId               String
  sourceChargeMinor           BigInt
  amountMinor                 BigInt
  currency                    String
  status                      PartnerPayableStatus @default(PENDING_APPROVAL)
  generatedAt                 DateTime             @default(now())
  approvedByUserId            String?
  approvedAt                  DateTime?
  reconciledAt                DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  partner     TransportPartner          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  assignment  PartnerDeliveryAssignment @relation(fields: [partnerDeliveryAssignmentId], references: [id], onDelete: Restrict)
  agreement   PartnerAgreement          @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  deliveryLeg DeliveryLeg               @relation(fields: [deliveryLegId], references: [id], onDelete: Restrict)
