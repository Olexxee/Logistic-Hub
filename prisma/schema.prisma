  approvedBy User?         @relation("PartnerPayableAdjustmentApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([payableId, createdAt])
  @@index([approvedAt, appliedAt])
  @@map("partner_payable_adjustments")
}

model PartnerSettlementBatch {
  id                     String                       @id @default(cuid())
  partnerId              String
  reference              String                       @unique
  idempotencyKey         String                       @unique
  currency               String
  periodStart            DateTime
  periodEnd              DateTime
  totalAmountMinor       BigInt
  status                 PartnerSettlementBatchStatus @default(DRAFT)
  approvedByUserId       String?
  approvedAt             DateTime?
  reconciledByUserId     String?
  reconciledAt           DateTime?
  externalReference      String?
  reconciliationOutcome PartnerReconciliationOutcome?
  reconciledAmountMinor  BigInt?
  evidence               Json?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  partner      TransportPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
