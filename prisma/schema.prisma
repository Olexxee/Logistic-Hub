}


model IntegrationWebhookDelivery {
  id              String    @id @default(cuid())
  eventId         String
  endpointId      String
  secretVersion   Int
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  totalAttempts   Int       @default(0)
  replayCount     Int       @default(0)
  availableAt     DateTime  @default(now())
  lockedAt        DateTime?
  lockedBy        String?
  lastHttpStatus  Int?
  lastErrorCode   String?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event              IntegrationShipmentEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint           IntegrationWebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  secretVersionRecord IntegrationWebhookSecretVersion @relation(fields: [endpointId, secretVersion], references: [endpointId, version], onDelete: Restrict)

  @@unique([eventId, endpointId])
  @@index([status, availableAt, createdAt])
  @@index([status, lockedAt])
  @@index([endpointId, status, createdAt])
  @@map("integration_webhook_deliveries")
}

model IntegrationWebhookAuditEvent {
