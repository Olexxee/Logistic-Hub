// ─────────────────────────────────────────────────────────────────────────────
// Prisma schema — Logistics Hub
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═════════════════════════════════════════════════════════════════════════════

enum IntegrationClientStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum IntegrationCredentialStatus {
  ACTIVE
  REVOKED
}

enum IntegrationWebhookEndpointStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum IntegrationBillingModel {
  PLATFORM_COLLECTED
  LOGISTIC_HUB_COLLECTED
  PREPAID_ACCOUNT
  INVOICE
}

enum IntegrationAgreementStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum IntegrationQuoteSessionStatus {
  QUOTED
  SELECTED
  BOOKED
  REQUIRES_MEASUREMENT
  REQUIRES_OPERATIONAL_PRICING
  NO_COVERAGE
  EXPIRED
}

enum IntegrationQuoteOptionStatus {
  AVAILABLE
  SELECTED
  REJECTED
  EXPIRED
}

enum PackageAssessmentStatus {
  DECLARED
  ESTIMATED
  MEASURED
  REQUIRES_MEASUREMENT
}

enum UserRole {
  CUSTOMER
  DRIVER
  HUB_OPERATOR
  PARTNER_OPERATOR
  SUPPORT
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DriverKycTier {
  UNASSESSED
  TEST_LIMITED
  FULL
}

enum DriverDocumentType {
  IDENTITY
  DRIVER_LICENSE
  VEHICLE_REGISTRATION
  VEHICLE_INSURANCE
  ROADWORTHINESS
}

enum DriverDocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  VAN
  PICKUP
  TRUCK
}

enum ServiceType {
  PARCEL_DELIVERY
  PASSENGER_RIDE
  HUB_POINT
  BUSINESS_LOGISTICS
}

enum BookingStatus {
  DRAFT
  MATCHING
  AWAITING_CUSTOMER_ACCEPTANCE
  AWAITING_PAYMENT
  PAYMENT_PENDING
  AWAITING_PARTNER_ASSIGNMENT
  DRIVER_ASSIGNED
  PICKUP_VERIFICATION_PENDING
  PICKED_UP
  IN_TRANSIT
  DELIVERY_VERIFICATION_PENDING
  COMPLETED
  CANCELLATION_PENDING
  CANCELLED
  FAILED
}

enum RideStatus {
  DRAFT
  MATCHING
  AWAITING_CUSTOMER_ACCEPTANCE
  AWAITING_PAYMENT
  PAYMENT_PENDING
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  PICKUP_VERIFICATION_PENDING
  TRIP_IN_PROGRESS
  TRIP_COMPLETION_PENDING
  COMPLETED
  CANCELLATION_PENDING
  CANCELLED
  NO_DRIVER_FOUND
  FAILED
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
  REVERSED
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum AssignmentStatus {
  AWAITING_PAYMENT
  ACCEPTED
  ARRIVED_AT_PICKUP
  PICKUP_CONFIRMED
  IN_PROGRESS
  ARRIVED_AT_DESTINATION
  COMPLETED
  CANCELLED
  FAILED
}

enum DeliveryLegType {
  DIRECT
  LOCAL_PICKUP
  HUB_TRANSFER
  INTERSTATE_TRANSPORT
  FINAL_MILE
}

enum DeliveryLegStatus {
  PLANNED
  READY_FOR_ASSIGNMENT
  AWAITING_PAYMENT
  ASSIGNED
  PICKUP_VERIFICATION_PENDING
  IN_TRANSIT
  DELIVERY_VERIFICATION_PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum VerificationAction {
  PARCEL_PICKUP
  PARCEL_DELIVERY
  RIDE_PICKUP
  RIDE_COMPLETION
}

enum VerificationTokenStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  REVOKED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum LedgerEntrySide {
  DEBIT
  CREDIT
}

enum PayoutStatus {
  PENDING
  ELIGIBLE
  PROCESSING
  PAID
  FAILED
  REVERSED
}

enum SettlementAccountStatus {
  PENDING
  ACTIVE
  RESTRICTED
  DISABLED
}

enum HubPointStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum HubApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PartnerAgreementStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED
}

enum PartnerRateCardStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum ShipmentQuoteStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum PartnerAssignmentStatus {
  ASSIGNED
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  FAILED
  CANCELLED
}

enum PartnerPayableStatus {
  PENDING_APPROVAL
  APPROVED
  IN_BATCH
  RECONCILED
  DISPUTED
  VOIDED
}

enum PartnerSettlementBatchStatus {
  DRAFT
  APPROVED
  RECONCILIATION_REQUIRED
  RECONCILED
  VOIDED
}

enum PartnerReconciliationOutcome {
  MATCHED
  VARIANCE
  DISPUTED
}

enum PartnerPayableAdjustmentType {
  INCREASE
  DECREASE
  REVERSAL
}

enum CustodyPartyType {
  SENDER
  DRIVER
  HUB
  TRANSPORT_PARTNER
  RECIPIENT
}

enum CustodyHandoverStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
}

enum OperationalCaseType {
  FAILED_HANDOVER
  DAMAGED_PARCEL
  MISSING_PARCEL
  FAILED_DELIVERY
  PARTNER_DELAY
  ROUTE_DISRUPTION
  PRICING_EXCEPTION
  CUSTOMER_DISPUTE
  OTHER
}

enum OperationalCaseStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum OperationalCasePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum PartnerMemberRole {
  OWNER
  OPERATIONS
  DISPATCHER
}

enum HubOperatorRole {
  MANAGER
  OPERATOR
}

enum HubIntakeStatus {
  RECEIVED
  RELEASED
  EXCEPTION
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SupportTicketMessageVisibility {
  PUBLIC
  INTERNAL
}

// ═════════════════════════════════════════════════════════════════════════════
// IDENTITY & AUTH
// ═════════════════════════════════════════════════════════════════════════════

model User {
  id              String     @id @default(cuid())
  fullName        String
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  operationalAuditEvents OperationalAuditEvent[] @relation("OperationalAuditActor")
  partnerMemberships TransportPartnerMember[]
  submittedHubApplications HubApplication[] @relation("HubApplicationApplicant")
  reviewedHubApplications HubApplication[] @relation("HubApplicationReviewer")
  hubMemberships HubPointOperator[]
  initiatedCustodyHandovers CustodyHandover[] @relation("CustodyHandoverInitiator")
  confirmedCustodyHandovers CustodyHandover[] @relation("CustodyHandoverConfirmer")
  reportedOperationalCases OperationalCase[] @relation("OperationalCaseReporter")
  assignedOperationalCases OperationalCase[] @relation("OperationalCaseAssignee")
  createdPartnerAssignments PartnerDeliveryAssignment[] @relation("PartnerDeliveryAssignmentAssigner")
  reviewedDriverDocuments DriverVerificationDocument[] @relation("DriverDocumentReviewer")
  driverProfile    DriverProfile?
  sentParcels      ParcelBooking[]    @relation("ParcelSender")
  rideBookings     RideBooking[]      @relation("RidePassenger")
  assignments      DriverAssignment[]
  notifications    Notification[]
  authActionTokens AuthActionToken[]
  authSessions     AuthSession[]
  acceptedShipmentQuotes ShipmentQuote[] @relation("ShipmentQuoteAcceptedBy")
  approvedPartnerPayables PartnerPayable[] @relation("PartnerPayableApprover")
  createdPartnerPayableAdjustments PartnerPayableAdjustment[] @relation("PartnerPayableAdjustmentCreator")
  approvedPartnerPayableAdjustments PartnerPayableAdjustment[] @relation("PartnerPayableAdjustmentApprover")
  approvedPartnerSettlementBatches PartnerSettlementBatch[] @relation("PartnerSettlementBatchApprover")
  reconciledPartnerSettlementBatches PartnerSettlementBatch[] @relation("PartnerSettlementBatchReconciler")
  partnerSettlementReconciliations PartnerSettlementReconciliation[] @relation("PartnerSettlementReconciliationActor")
  receivedHubIntakes HubIntakeRecord[] @relation("HubIntakeReceiver")
  supportTicketMessages SupportTicketMessage[] @relation("SupportTicketMessageAuthor")
  uploadedMediaAssets MediaAsset[] @relation("MediaAssetUploader")

  @@index([role, status])
  @@map("users")
}

model AuthActionToken {
  id         String           @id @default(cuid())
  userId     String
  purpose    AuthTokenPurpose
  tokenHash  String           @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([purpose, expiresAt])
  @@map("auth_action_tokens")
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  userAgent  String?
  ipHash     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Notification {
  id              String    @id @default(cuid())
  userId          String
  type            String
  title           String
  body            String
  data            Json?
  readAt          DateTime?
  emailStatus     String    @default("NOT_REQUESTED")
  emailSentAt     DateTime?
  emailProviderId String?
  emailErrorCode  String?
  deliveryKey     String?   @unique
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([emailStatus, createdAt])
  @@map("notifications")
}

// ═════════════════════════════════════════════════════════════════════════════
// DRIVERS & VEHICLES
// ═════════════════════════════════════════════════════════════════════════════

model DriverProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  verificationStatus  VerificationStatus @default(NOT_SUBMITTED)
  kycTier             DriverKycTier       @default(UNASSESSED)
  suspendedAt         DateTime?
  suspensionReason    String?
  reinstatedAt        DateTime?
  isOnline            Boolean            @default(false)
  isAvailable         Boolean            @default(false)
  serviceRadiusMeters Int                @default(5000)
  averageRating       Decimal?           @db.Decimal(3, 2)
  completedJobs       Int                @default(0)
  cancelledJobs       Int                @default(0)
  lastLocationAt      DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles           Vehicle[]
  verificationDocuments DriverVerificationDocument[]
  locations          DriverLocation[]
  coverage           DriverCoverage[]
  offers             DriverOffer[]
  deliveryLegOffers  DeliveryLegOffer[]
  assignments        DriverAssignment[]
  payouts            DriverPayout[]
  settlementAccounts DriverSettlementAccount[]

  @@index([verificationStatus, isOnline, isAvailable])
  @@map("driver_profiles")
}

model DriverSettlementAccount {
  id                 String                  @id @default(cuid())
  driverProfileId    String
  provider           String                  @default("PAYSTACK")
  externalAccountRef String
  status             SettlementAccountStatus @default(PENDING)
  currency           String                  @default("NGN")
  verifiedAt         DateTime?
  metadata           Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  driverProfile   DriverProfile    @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)
  paymentAttempts PaymentAttempt[]

  @@unique([driverProfileId, provider])
  @@unique([provider, externalAccountRef])
  @@index([status, provider])
  @@map("driver_settlement_accounts")
}

model Vehicle {
  id                 String             @id @default(cuid())
  driverProfileId    String
  type               VehicleType
  make               String?
  model              String?
  registrationPlate  String?            @unique
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  isActive           Boolean            @default(false)
  parcelCapacity     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  verificationDocuments DriverVerificationDocument[]

  @@index([driverProfileId, isActive, verificationStatus])
  @@map("vehicles")
}

model DriverVerificationDocument {
  id             String                     @id @default(cuid())
  driverProfileId String
  vehicleId      String?
  mediaAssetId   String                     @unique
  documentType   DriverDocumentType
  reviewStatus   DriverDocumentReviewStatus @default(PENDING)
  reviewReason   String?
  reviewedAt     DateTime?
  reviewedById   String?
  expiresAt      DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  reviewedBy    User?         @relation("DriverDocumentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([driverProfileId, documentType, reviewStatus, createdAt])
  @@index([vehicleId, documentType, reviewStatus, createdAt])
  @@index([reviewStatus, createdAt])
  @@map("driver_verification_documents")
}

model DriverLocation {
  id              String   @id @default(cuid())
  driverProfileId String
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  accuracyMeters  Decimal? @db.Decimal(8, 2)
  recordedAt      DateTime @default(now())

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([driverProfileId, recordedAt])
  @@index([recordedAt])
  @@map("driver_locations")
}

// ═════════════════════════════════════════════════════════════════════════════
// GEOGRAPHY & ZONES
// ═════════════════════════════════════════════════════════════════════════════

model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states State[]

  @@map("countries")
}

model State {
  id        String   @id @default(cuid())
  countryId String
  code      String
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country       @relation(fields: [countryId], references: [id], onDelete: Restrict)
  lgas    LGA[]
  zones   ServiceZone[]

  @@unique([countryId, code])
  @@unique([countryId, name])
  @@index([countryId, isActive])
  @@map("states")
}

model LGA {
  id        String   @id @default(cuid())
  stateId   String
  code      String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state State         @relation(fields: [stateId], references: [id], onDelete: Restrict)
  zones ServiceZone[]

  @@unique([id, stateId])
  @@unique([stateId, name])
  @@unique([stateId, code])
  @@index([stateId])
  @@map("lgas")
}

model ServiceZone {
  id             String  @id @default(cuid())
  stateId        String
  lgaId          String?
  code           String
  name           String
  isActive       Boolean @default(false)
  boundaryGeoJson Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  state                    State                 @relation(fields: [stateId], references: [id], onDelete: Restrict)
  lga                      LGA?                  @relation(fields: [lgaId, stateId], references: [id, stateId], onDelete: Restrict)
  availability             ServiceAvailability[]
  coverage                 DriverCoverage[]
  pickupParcelBookings     ParcelBooking[]       @relation("ParcelPickupZone")
  destinationParcelBookings ParcelBooking[]      @relation("ParcelDestinationZone")
  pickupRideBookings       RideBooking[]         @relation("RidePickupZone")
  destinationRideBookings  RideBooking[]         @relation("RideDestinationZone")
  hubPoints                HubPoint[]
  hubApplications          HubApplication[]
  originDeliveryLegs       DeliveryLeg[] @relation("DeliveryLegOriginZone")
  destinationDeliveryLegs  DeliveryLeg[] @relation("DeliveryLegDestinationZone")
  pricingRules             PricingRule[]
  partnerRateOrigins       PartnerRate[] @relation("PartnerRateOriginZone")
  partnerRateDestinations  PartnerRate[] @relation("PartnerRateDestinationZone")

  @@unique([stateId, code])
  @@index([stateId, isActive])
  @@index([lgaId])
  @@map("service_zones")
}

model ServiceAvailability {
  id            String      @id @default(cuid())
  serviceZoneId String
  serviceType   ServiceType
  isEnabled     Boolean     @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  config        Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  serviceZone ServiceZone @relation(fields: [serviceZoneId], references: [id], onDelete: Cascade)

  @@unique([serviceZoneId, serviceType])
  @@index([serviceType, isEnabled])
  @@map("service_availability")
}

model DriverCoverage {
  id              String      @id @default(cuid())
  driverProfileId String
  serviceZoneId   String
  serviceType     ServiceType
  isEnabled       Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  serviceZone   ServiceZone   @relation(fields: [serviceZoneId], references: [id], onDelete: Cascade)

  @@unique([driverProfileId, serviceZoneId, serviceType])
  @@index([serviceZoneId, serviceType, isEnabled])
  @@map("driver_coverage")
}

model HubPoint {
  id                  String         @id @default(cuid())
  partnerId           String?
  serviceZoneId       String
  name                String
  address             String
  latitude            Decimal        @db.Decimal(10, 7)
  longitude           Decimal        @db.Decimal(10, 7)
  status              HubPointStatus @default(PENDING)
  operatorName        String?
  operatorPhone       String?
  operatorVerificationStatus VerificationStatus @default(NOT_SUBMITTED)
  operatorVerifiedAt  DateTime?
  operatorVerificationNotes String?
  openingHours        Json?
  acceptedParcelTypes Json?
  capacityConfig      Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  partner TransportPartner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  serviceZone ServiceZone @relation(fields: [serviceZoneId], references: [id], onDelete: Restrict)
  originDeliveryLegs DeliveryLeg[] @relation("DeliveryLegOriginHub")
  destinationDeliveryLegs DeliveryLeg[] @relation("DeliveryLegDestinationHub")
  operators HubPointOperator[]
  application HubApplication?
  custodyHandovers CustodyHandover[]
  operationalCases OperationalCase[]
  intakeRecords HubIntakeRecord[]

  @@index([serviceZoneId, status])
  @@index([partnerId, status])
  @@map("hub_points")
}

model HubApplication {
  id                         String               @id @default(cuid())
  partnerId                  String
  applicantUserId             String
  serviceZoneId               String
  name                        String
  address                     String
  latitude                    Decimal              @db.Decimal(10, 7)
  longitude                   Decimal              @db.Decimal(10, 7)
  operatorName                String
  operatorPhone               String
  openingHours                Json
  acceptedParcelTypes         Json
  capacityConfig              Json
  status                      HubApplicationStatus @default(PENDING)
  reviewReason                String?
  reviewedAt                  DateTime?
  reviewedByUserId            String?
  hubPointId                  String?              @unique
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  partner      TransportPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  applicant    User             @relation("HubApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewer     User?            @relation("HubApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  serviceZone  ServiceZone      @relation(fields: [serviceZoneId], references: [id], onDelete: Restrict)
  hubPoint     HubPoint?        @relation(fields: [hubPointId], references: [id], onDelete: Restrict)

  @@index([partnerId, status, createdAt])
  @@index([applicantUserId, createdAt])
  @@index([status, createdAt])
  @@map("hub_applications")
}

// ═════════════════════════════════════════════════════════════════════════════
// PRICING
// ═════════════════════════════════════════════════════════════════════════════

model PricingRule {
  id                      String      @id @default(cuid())
  serviceZoneId           String?
  serviceType             ServiceType
  currency                String      @default("NGN")
  fixedConnectionFeeMinor BigInt
  minimumDriverFareMinor  BigInt      @default(0)
  baseFareMinor           BigInt      @default(0)
  perKmMinor              BigInt      @default(0)
  perMinuteMinor          BigInt      @default(0)
  config                  Json?
  version                 Int         @default(1)
  isActive                Boolean     @default(false)
  effectiveFrom           DateTime    @default(now())
  effectiveUntil          DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  serviceZone ServiceZone? @relation(fields: [serviceZoneId], references: [id], onDelete: Restrict)

  @@index([serviceType, isActive, effectiveFrom])
  @@index([serviceZoneId, serviceType, isActive])
  @@map("pricing_rules")
}

// ═════════════════════════════════════════════════════════════════════════════
// BOOKINGS — PARCELS & RIDES
// ═════════════════════════════════════════════════════════════════════════════

model ParcelBooking {
  id                            String        @id @default(cuid())
  publicReference               String        @unique
  idempotencyKey                String?       @unique
  idempotencyPayloadHash        String?
  fareAcceptanceIdempotencyKey  String?       @unique
  fareAcceptancePayloadHash     String?
  senderId                      String?
  integrationClientId            String?
  integrationEventSequence      Int           @default(0)
  pickupServiceZoneId           String
  destinationServiceZoneId      String
  status                        BookingStatus @default(DRAFT)
  paymentStatus                 PaymentStatus @default(INITIALIZED)
  currency                      String        @default("NGN")
  pickupAddress                 String
  pickupLatitude                Decimal       @db.Decimal(10, 7)
  pickupLongitude               Decimal       @db.Decimal(10, 7)
  pickupInstructions            String?
  destinationAddress            String
  destinationLatitude           Decimal       @db.Decimal(10, 7)
  destinationLongitude          Decimal       @db.Decimal(10, 7)
  recipientName                 String
  recipientPhone                String
  // Legacy single-parcel fields remain populated for customer-owned bookings.
  // Integration-owned consignments use parcelPackages and must not be flattened.
  parcelCategory                String?
  parcelDescription             String?
  parcelSize                    String?
  declaredValueMinor            BigInt?
  handlingInstructions          String?
  driverFareMinor               BigInt?
  connectionFeeMinor            BigInt
  otherChargesMinor             BigInt        @default(0)
  customerPayableMinor          BigInt?
  pricingRuleId                 String?
  pricingSnapshot               Json
  paidAt                        DateTime?
  pickedUpAt                    DateTime?
  completedAt                   DateTime?
  cancelledAt                   DateTime?
  cancellationReason            String?
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  sender                 User?             @relation("ParcelSender", fields: [senderId], references: [id], onDelete: Restrict)
  integrationClient      IntegrationClient? @relation(fields: [integrationClientId], references: [id], onDelete: Restrict)
  pickupServiceZone      ServiceZone       @relation("ParcelPickupZone", fields: [pickupServiceZoneId], references: [id], onDelete: Restrict)
  destinationServiceZone ServiceZone       @relation("ParcelDestinationZone", fields: [destinationServiceZoneId], references: [id], onDelete: Restrict)
  offers                 DriverOffer[]
  assignments            DriverAssignment[]
  paymentAttempts        PaymentAttempt[]
  verificationTokens     VerificationToken[]
  events                 BookingEvent[]
  ledgerEntries          LedgerEntry[]
  payouts                DriverPayout[]
  refunds                RefundRequest[]
  supportTickets         SupportTicket[]
  quotes                 ShipmentQuote[]
  deliveryLegs           DeliveryLeg[]
  custodyHandovers       CustodyHandover[]
  operationalCases       OperationalCase[]
  hubIntakeRecords       HubIntakeRecord[]
  parcelPackages         ParcelBookingPackage[]
  integrationPaymentAttestation IntegrationPaymentAttestation?
  integrationEvents              IntegrationShipmentEvent[]
  integrationPackingEvidence      IntegrationPackingEvidence[]

  @@index([senderId, createdAt])
  @@index([integrationClientId, createdAt])
  @@index([pickupServiceZoneId, status, createdAt])
  @@index([destinationServiceZoneId, status, createdAt])
  @@index([status, paymentStatus, createdAt])
  @@map("parcel_bookings")
}

model ParcelBookingPackage {
  id                  String                  @id @default(cuid())
  parcelBookingId     String
  packageSequence     Int
  externalPackageRef  String?
  packageCategory     String
  description         String?
  weightGrams         Int?
  lengthMm            Int?
  widthMm             Int?
  heightMm            Int?
  declaredValueMinor  BigInt?
  assessmentStatus    PackageAssessmentStatus @default(DECLARED)
  assessmentSource    String                  @default("INTEGRATOR_DECLARED")
  assessmentConfidence Decimal?                @db.Decimal(5, 4)
  assessedAt          DateTime                @default(now())
  createdAt           DateTime                @default(now())

  parcelBooking ParcelBooking @relation(fields: [parcelBookingId], references: [id], onDelete: Restrict)

  @@unique([parcelBookingId, packageSequence])
  @@unique([parcelBookingId, externalPackageRef])
  @@index([parcelBookingId, createdAt])
  @@index([parcelBookingId, assessmentStatus])
  @@map("parcel_booking_packages")
}

model RideBooking {
  id                            String        @id @default(cuid())
  publicReference               String        @unique
  idempotencyKey                String?       @unique
  idempotencyPayloadHash        String?
  fareAcceptanceIdempotencyKey  String?       @unique
  fareAcceptancePayloadHash     String?
  passengerId                   String
  pickupServiceZoneId           String
  destinationServiceZoneId      String
  status                        RideStatus    @default(DRAFT)
  paymentStatus                 PaymentStatus @default(INITIALIZED)
  currency                      String        @default("NGN")
  pickupAddress                 String
  pickupLatitude                Decimal       @db.Decimal(10, 7)
  pickupLongitude               Decimal       @db.Decimal(10, 7)
  destinationAddress            String
  destinationLatitude           Decimal       @db.Decimal(10, 7)
  destinationLongitude          Decimal       @db.Decimal(10, 7)
  vehicleType                   VehicleType
  driverFareMinor               BigInt?
  connectionFeeMinor            BigInt
  customerPayableMinor          BigInt?
  pricingSnapshot               Json
  paidAt                        DateTime?
  tripStartedAt                 DateTime?
  completedAt                   DateTime?
  cancelledAt                   DateTime?
  cancellationReason            String?
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  passenger              User              @relation("RidePassenger", fields: [passengerId], references: [id], onDelete: Restrict)
  pickupServiceZone      ServiceZone       @relation("RidePickupZone", fields: [pickupServiceZoneId], references: [id], onDelete: Restrict)
  destinationServiceZone ServiceZone       @relation("RideDestinationZone", fields: [destinationServiceZoneId], references: [id], onDelete: Restrict)
  offers                 DriverOffer[]
  assignments            DriverAssignment[]
  paymentAttempts        PaymentAttempt[]
  events                 BookingEvent[]
  ledgerEntries          LedgerEntry[]
  payouts                DriverPayout[]
  refunds                RefundRequest[]
  supportTickets         SupportTicket[]
  verificationTokens     VerificationToken[]

  @@index([passengerId, createdAt])
  @@index([pickupServiceZoneId, status, createdAt])
  @@index([destinationServiceZoneId, status, createdAt])
  @@map("ride_bookings")
}

// ═════════════════════════════════════════════════════════════════════════════
// MATCHING — OFFERS & ASSIGNMENTS
// ═════════════════════════════════════════════════════════════════════════════

model DriverOffer {
  id                          String      @id @default(cuid())
  parcelBookingId             String?
  rideBookingId               String?
  driverProfileId             String
  status                      OfferStatus @default(OFFERED)
  proposedFareMinor           BigInt?
  fareProposalIdempotencyKey  String?     @unique
  fareProposalPayloadHash     String?
  currency                    String      @default("NGN")
  expiresAt                   DateTime
  respondedAt                 DateTime?
  createdAt                   DateTime    @default(now())

  parcelBooking ParcelBooking? @relation(fields: [parcelBookingId], references: [id], onDelete: Cascade)
  rideBooking   RideBooking?   @relation(fields: [rideBookingId],   references: [id], onDelete: Cascade)
  driverProfile DriverProfile  @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([driverProfileId, status, expiresAt])
  @@index([parcelBookingId, status, expiresAt])
  @@index([rideBookingId, status, expiresAt])
  @@map("driver_offers")
}

model DriverAssignment {
  id               String           @id @default(cuid())
  parcelBookingId  String?
  rideBookingId    String?
  deliveryLegId    String?
  driverProfileId  String
  assignedByUserId String?
  status           AssignmentStatus @default(AWAITING_PAYMENT)
  agreedFareMinor  BigInt
  currency         String           @default("NGN")
  reservedAt       DateTime         @default(now())
  paymentExpiresAt DateTime?
  acceptedAt       DateTime?
  pickupAt         DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  failureReason    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  parcelBooking ParcelBooking? @relation(fields: [parcelBookingId], references: [id], onDelete: Restrict)
  rideBooking   RideBooking?   @relation(fields: [rideBookingId],   references: [id], onDelete: Restrict)
  driverProfile DriverProfile  @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)
  assignedBy    User?          @relation(fields: [assignedByUserId], references: [id], onDelete: SetNull)
  deliveryLeg   DeliveryLeg?   @relation(fields: [deliveryLegId], references: [id], onDelete: Restrict)

  @@index([driverProfileId, status, reservedAt])
  @@index([parcelBookingId, status])
  @@index([rideBookingId, status])
  @@index([deliveryLegId, status])
  @@map("driver_assignments")
}

model DeliveryLeg {
  id                     String           @id @default(cuid())
  parcelBookingId        String
  sequence               Int
  type                   DeliveryLegType
  status                 DeliveryLegStatus @default(PLANNED)
  originServiceZoneId    String
  destinationServiceZoneId String
  originHubPointId        String?
  destinationHubPointId   String?
  originLatitude          Decimal? @db.Decimal(10, 7)
  originLongitude         Decimal? @db.Decimal(10, 7)
  destinationLatitude     Decimal? @db.Decimal(10, 7)
  destinationLongitude    Decimal? @db.Decimal(10, 7)
  plannedAt              DateTime?
  assignedAt             DateTime?
  pickedUpAt             DateTime?
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  failureReason          String?
  metadata               Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  parcelBooking     ParcelBooking @relation(fields: [parcelBookingId], references: [id], onDelete: Restrict)
  originServiceZone ServiceZone   @relation("DeliveryLegOriginZone", fields: [originServiceZoneId], references: [id], onDelete: Restrict)
  destinationServiceZone ServiceZone @relation("DeliveryLegDestinationZone", fields: [destinationServiceZoneId], references: [id], onDelete: Restrict)
  originHubPoint HubPoint? @relation("DeliveryLegOriginHub", fields: [originHubPointId], references: [id], onDelete: Restrict)
  destinationHubPoint HubPoint? @relation("DeliveryLegDestinationHub", fields: [destinationHubPointId], references: [id], onDelete: Restrict)
  assignments       DriverAssignment[]
  offers             DeliveryLegOffer[]
  verificationTokens VerificationToken[]
  partnerAssignments PartnerDeliveryAssignment[]
  partnerPayables PartnerPayable[]
  custodyHandovers   CustodyHandover[]
  operationalCases   OperationalCase[]
  hubIntakeRecords HubIntakeRecord[]

  @@unique([parcelBookingId, sequence])
  @@index([status, plannedAt])
  @@index([originServiceZoneId, destinationServiceZoneId, status], map: "delivery_legs_route_status_idx")
  @@index([originHubPointId])
  @@index([destinationHubPointId])
  @@map("delivery_legs")
}


model DeliveryLegOffer {
  id                         String      @id @default(cuid())
  deliveryLegId              String
  driverProfileId            String
  status                     OfferStatus @default(OFFERED)
  proposedFareMinor          BigInt?
  proposalIdempotencyKey     String?     @unique
  proposalPayloadHash        String?
  acceptanceIdempotencyKey   String?     @unique
  acceptancePayloadHash      String?
  currency                   String      @default("NGN")
  expiresAt                  DateTime
  respondedAt                DateTime?
  createdAt                  DateTime    @default(now())

  deliveryLeg   DeliveryLeg  @relation(fields: [deliveryLegId], references: [id], onDelete: Cascade)
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)

  @@index([deliveryLegId, status, expiresAt])
  @@index([driverProfileId, status, expiresAt])
  @@map("delivery_leg_offers")
}

// ═════════════════════════════════════════════════════════════════════════════
// PAYMENTS, LEDGER, PAYOUTS, REFUNDS
// ═════════════════════════════════════════════════════════════════════════════

model PaymentAttempt {
  id                          String        @id @default(cuid())
  parcelBookingId             String?
  rideBookingId               String?
  provider                    String        @default("PAYSTACK")
  providerReference           String?       @unique
  idempotencyKey              String        @unique
  status                      PaymentStatus @default(INITIALIZED)
  amountMinor                 BigInt
  currency                    String        @default("NGN")
  providerFeeMinor            BigInt?
  driverAllocationMinor       BigInt?
  platformAllocationMinor     BigInt?
  driverSettlementAccountId   String?
  splitConfigurationSnapshot  Json?
  providerPayload             Json?
  initializedAt               DateTime      @default(now())
  verifiedAt                  DateTime?
  failedAt                    DateTime?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  parcelBooking           ParcelBooking?           @relation(fields: [parcelBookingId], references: [id], onDelete: Restrict)
  rideBooking             RideBooking?             @relation(fields: [rideBookingId], references: [id], onDelete: Restrict)
  driverSettlementAccount DriverSettlementAccount? @relation(fields: [driverSettlementAccountId], references: [id], onDelete: Restrict)
  ledgerEntries           LedgerEntry[]
  refundRequests          RefundRequest[]

  @@index([parcelBookingId, status])
  @@index([rideBookingId, status])
  @@index([provider, status, createdAt])
  @@map("payment_attempts")
}

model LedgerAccount {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String
  type      LedgerAccountType
  currency  String            @default("NGN")
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  entries LedgerEntry[]

  @@index([type, currency, isActive])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id               String          @id @default(cuid())
  journalReference String
  accountId        String
  side             LedgerEntrySide
  amountMinor      BigInt
  currency         String          @default("NGN")
  parcelBookingId  String?
  rideBookingId    String?
  paymentAttemptId String?
  payoutId         String?
  description      String
  metadata         Json?
  postedAt         DateTime        @default(now())

  account        LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  parcelBooking  ParcelBooking?  @relation(fields: [parcelBookingId], references: [id], onDelete: Restrict)
  rideBooking    RideBooking?    @relation(fields: [rideBookingId], references: [id], onDelete: Restrict)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  payout         DriverPayout?   @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([journalReference])
  @@index([accountId, postedAt])
  @@index([parcelBookingId])
  @@index([rideBookingId])
  @@map("ledger_entries")
}

model DriverPayout {
  id                String       @id @default(cuid())
  driverProfileId   String
  parcelBookingId   String?
  rideBookingId     String?
  amountMinor       BigInt
  currency          String       @default("NGN")
  status            PayoutStatus @default(PENDING)
  provider          String       @default("PAYSTACK")
  providerReference String?      @unique
  idempotencyKey    String       @unique
  failureReason     String?
  providerPayload   Json?
  requestedAt       DateTime     @default(now())
  processedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  driverProfile DriverProfile   @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)
  parcelBooking ParcelBooking?  @relation(fields: [parcelBookingId], references: [id], onDelete: Restrict)
  rideBooking   RideBooking?    @relation(fields: [rideBookingId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([driverProfileId, status, createdAt])
  @@index([status, createdAt])
  @@map("driver_payouts")
}

model RefundRequest {
  id                String    @id @default(cuid())
  publicReference   String    @unique
  paymentAttemptId  String
  parcelBookingId   String?   // NEW — relation back to ParcelBooking
  rideBookingId     String?   // NEW — relation back to RideBooking
  amountMinor       BigInt
  currency          String    @default("NGN")
  reason            String
  status            String    @default("PENDING_REVIEW")
  requestedByUserId String
  reviewedByUserId  String?
  providerReference String?   @unique
  idempotencyKey    String    @unique
  providerResponse  Json?
  reviewedAt        DateTime?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  parcelBooking  ParcelBooking? @relation(fields: [parcelBookingId], references: [id], onDelete: Restrict)   // NEW
  rideBooking    RideBooking?   @relation(fields: [rideBookingId],   references: [id], onDelete: Restrict)   // NEW

  @@index([status, createdAt])
  @@index([paymentAttemptId, status])
  @@index([parcelBookingId, status])   // NEW
  @@index([rideBookingId, status])     // NEW
  @@map("refund_requests")
}

// ═════════════════════════════════════════════════════════════════════════════
// VERIFICATION & EVENTS
// ═════════════════════════════════════════════════════════════════════════════

model VerificationToken {
  id               String                  @id @default(cuid())
  parcelBookingId  String?
  rideBookingId    String?
  deliveryLegId    String?
  action           VerificationAction
  tokenHash        String                  @unique
  status           VerificationTokenStatus @default(ACTIVE)
  expiresAt        DateTime
  failedAttempts   Int                     @default(0)
  consumedAt       DateTime?
  consumedByUserId String?
  createdAt        DateTime                @default(now())

  parcelBooking ParcelBooking? @relation(fields: [parcelBookingId], references: [id], onDelete: Cascade)
  rideBooking   RideBooking?   @relation(fields: [rideBookingId], references: [id], onDelete: Cascade)
  deliveryLeg   DeliveryLeg?   @relation(fields: [deliveryLegId], references: [id], onDelete: Restrict)

  @@index([parcelBookingId, action, status])
  @@index([rideBookingId, action, status])
  @@index([deliveryLegId, action, status])
  @@index([status, expiresAt])
  @@map("verification_tokens")
}

model BookingEvent {
  id              String   @id @default(cuid())
  parcelBookingId String?
  rideBookingId   String?
  actorUserId     String?
  eventType       String
  fromStatus      String?
  toStatus        String?
  metadata        Json?
  createdAt       DateTime @default(now())

  parcelBooking ParcelBooking? @relation(fields: [parcelBookingId], references: [id], onDelete: Cascade)
  rideBooking   RideBooking?   @relation(fields: [rideBookingId], references: [id], onDelete: Cascade)

  @@index([parcelBookingId, createdAt])
  @@index([rideBookingId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("booking_events")
}

// ═════════════════════════════════════════════════════════════════════════════
// SUPPORT
// ═════════════════════════════════════════════════════════════════════════════

model SupportTicket {
  id               String    @id @default(cuid())
  publicReference  String    @unique
  customerId       String
  assignedToUserId String?
  bookingType      String?
  bookingId        String?
  parcelBookingId  String?   // NEW — relation back to ParcelBooking
  rideBookingId    String?   // NEW — relation back to RideBooking
  operationalCaseId String?  @unique
  operationalCase   OperationalCase? @relation(fields: [operationalCaseId], references: [id], onDelete: SetNull)
  category         String
  subject          String
  description      String
  status           String    @default("OPEN")
  priority         String    @default("NORMAL")
  resolution       String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  parcelBooking ParcelBooking? @relation(fields: [parcelBookingId], references: [id], onDelete: SetNull)   // NEW
  rideBooking   RideBooking?   @relation(fields: [rideBookingId],   references: [id], onDelete: SetNull)   // NEW

  @@index([customerId, status, createdAt])
  @@index([status, priority, createdAt])
  @@index([assignedToUserId, status])
  @@index([parcelBookingId, status])   // NEW
  @@index([rideBookingId, status])     // NEW
  messages SupportTicketMessage[]
  attachments SupportTicketAttachment[]

  @@map("support_tickets")
}

model SupportTicketMessage {
  id          String                        @id @default(cuid())
  ticketId    String
  authorId    String
  visibility  SupportTicketMessageVisibility @default(PUBLIC)
  body        String
  createdAt   DateTime                      @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation("SupportTicketMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, visibility, createdAt, id])
  @@index([authorId, createdAt])
  @@map("support_ticket_messages")
}

model MediaAsset {
  id             String    @id @default(cuid())
  storageProvider String   @default("CLOUDINARY")
  bucket         String
  objectPath     String    @unique
  originalName   String
  mimeType       String
  sizeBytes      BigInt
  sha256         String
  uploadedById   String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  uploadedBy User @relation("MediaAssetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  ticketAttachments SupportTicketAttachment[]
  driverVerificationDocument DriverVerificationDocument?

  @@index([uploadedById, createdAt])
  @@index([deletedAt, createdAt])
  @@map("media_assets")
}

model SupportTicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  mediaAssetId String
  createdAt    DateTime @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([ticketId, mediaAssetId])
  @@index([ticketId, createdAt])
  @@index([mediaAssetId])
  @@map("support_ticket_attachments")
}

// ═════════════════════════════════════════════════════════════════════════════
// INFRASTRUCTURE — RATE LIMIT & WEBHOOKS
// ═════════════════════════════════════════════════════════════════════════════

model RateLimitBucket {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime
  windowEndsAt    DateTime
  updatedAt       DateTime @updatedAt

  @@index([windowEndsAt])
  @@map("rate_limit_buckets")
}

model ProviderWebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  payloadHash     String
  processedAt     DateTime?
  processingError String?
  receivedAt      DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([provider, processedAt, receivedAt])
  @@map("provider_webhook_events")
}

// ═════════════════════════════════════════════════════════════════════════════
// TRANSPORT PARTNERS & CONTRACTED RATES
// ═════════════════════════════════════════════════════════════════════════════

model TransportPartner {
  id                 String             @id @default(cuid())
  displayName        String
  legalName          String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  status             PartnerStatus      @default(PENDING)
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  verifiedAt         DateTime?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  agreements PartnerAgreement[]
  members TransportPartnerMember[]
  deliveryAssignments PartnerDeliveryAssignment[]
  operationalCases OperationalCase[]
  payables PartnerPayable[]
  settlementBatches PartnerSettlementBatch[]
  hubPoints HubPoint[]
  hubApplications HubApplication[]

  @@index([status, verificationStatus])
  @@map("transport_partners")
}

model PartnerAgreement {
  id                 String                 @id @default(cuid())
  partnerId          String
  reference          String                 @unique
  status             PartnerAgreementStatus @default(DRAFT)
  currency           String                 @default("NGN")
  effectiveFrom      DateTime               @default(now())
  effectiveUntil     DateTime?
  volumeCommitment   Json?
  serviceStandards   Json?
  custodyClaimsTerms Json?
  approvedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  partner   TransportPartner   @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  rateCards PartnerRateCard[]
  quotes    ShipmentQuote[]
  integrationQuoteOptions IntegrationQuoteOption[]
  deliveryAssignments PartnerDeliveryAssignment[]
  payables PartnerPayable[]

  @@index([partnerId, status, effectiveFrom])
  @@index([status, effectiveFrom, effectiveUntil])
  @@map("partner_agreements")
}

model PartnerRateCard {
  id             String                @id @default(cuid())
  agreementId    String
  version        Int
  status         PartnerRateCardStatus @default(DRAFT)
  currency       String                @default("NGN")
  effectiveFrom  DateTime              @default(now())
  effectiveUntil DateTime?
  publishedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  agreement PartnerAgreement @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  rates     PartnerRate[]
  integrationQuoteOptions IntegrationQuoteOption[]

  @@unique([agreementId, version])
  @@index([status, effectiveFrom, effectiveUntil])
  @@map("partner_rate_cards")
}

model PartnerRate {
  id                      String      @id @default(cuid())
  rateCardId              String
  originServiceZoneId     String
  destinationServiceZoneId String
  serviceType             ServiceType @default(PARCEL_DELIVERY)
  parcelCategory          String
  minWeightGrams          Int         @default(0)
  maxWeightGrams          Int?
  maxLengthMm             Int?
  maxWidthMm              Int?
  maxHeightMm             Int?
  transportChargeMinor    BigInt
  estimatedTransitMinutes Int?
  isActive                Boolean     @default(true)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  rateCard             PartnerRateCard @relation(fields: [rateCardId], references: [id], onDelete: Restrict)
  originServiceZone    ServiceZone     @relation("PartnerRateOriginZone", fields: [originServiceZoneId], references: [id], onDelete: Restrict)
  destinationServiceZone ServiceZone    @relation("PartnerRateDestinationZone", fields: [destinationServiceZoneId], references: [id], onDelete: Restrict)
  quotes               ShipmentQuote[]

  @@index([originServiceZoneId, destinationServiceZoneId, serviceType, parcelCategory, isActive], map: "partner_rates_originServiceZoneId_destinationServiceZoneId_serv")
  @@index([rateCardId, isActive])
  @@map("partner_rates")
}

model ShipmentQuote {
  id                            String              @id @default(cuid())
  parcelBookingId               String
  version                       Int
  status                        ShipmentQuoteStatus @default(OFFERED)
  partnerAgreementId            String?
  partnerRateId                 String?
  currency                      String              @default("NGN")
  transportChargeMinor          BigInt
  collectionChargeMinor         BigInt              @default(0)
  hubHandlingChargeMinor        BigInt              @default(0)
  destinationDeliveryChargeMinor BigInt              @default(0)
  platformChargeMinor           BigInt              @default(0)
  otherChargesMinor             BigInt              @default(0)
  totalCustomerChargeMinor      BigInt
  chargeBreakdown               Json
  inputSnapshot                 Json
  expiresAt                     DateTime
  offeredAt                     DateTime            @default(now())
  acceptedAt                    DateTime?
  acceptedByUserId              String?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt

  parcelBooking    ParcelBooking     @relation(fields: [parcelBookingId], references: [id], onDelete: Restrict)
  partnerAgreement PartnerAgreement? @relation(fields: [partnerAgreementId], references: [id], onDelete: Restrict)
