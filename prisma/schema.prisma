  evidence            Json?
  note                String?
  createdAt           DateTime                     @default(now())

  batch PartnerSettlementBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actor User                   @relation("PartnerSettlementReconciliationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([batchId, createdAt])
  @@map("partner_settlement_reconciliations")
}



model IntegrationClient {
